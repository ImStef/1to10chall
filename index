<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>10 Image Grid</title>

<style>
    /* =========================================================
       PAGE SETTINGS
       ========================================================= */

    html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #222; /* Change your background color here */
    }

    /*
       The actual design is always 1920x1080.
       It automatically scales down/up to fit the browser window.
    */
    .canvas {
        width: 1920px;
        height: 1080px;

        position: absolute;
        left: 50%;
        top: 50%;
        transform-origin: center center;
        transform: translate(-50%, -50%) scale(var(--scale));

        background: #222;
    }


    /* =========================================================
       GRID
       ========================================================= */

    .grid {
        width: 100%;
        height: 100%;

        display: grid;
        grid-template-columns: repeat(5, 1fr);
        grid-template-rows: repeat(2, 1fr);

        /*
           Adjust these if you want more/less space between items.
        */
        column-gap: 30px;
        row-gap: 35px;

        box-sizing: border-box;
        padding: 40px;
    }


    /* =========================================================
       EACH ITEM
       ========================================================= */

    .item {
        display: flex;
        flex-direction: column;

        min-width: 0;
        min-height: 0;
    }


    /* =========================================================
       IMAGE RECTANGLE
       ========================================================= */

    .image-box {
        width: 100%;

        /*
           1920:1080 = 16:9
        */
        aspect-ratio: 16 / 9;

        overflow: hidden;
        background: #111;
    }

    .image-box img {
        width: 100%;
        height: 100%;

        display: block;

        object-fit: cover;
    }


    /* =========================================================
       RATING BAR
       ========================================================= */

    .rating-container {
        width: 100%;

        /*
           Small rectangle underneath the image
        */
        height: 28px;

        margin-top: 12px;

        background: #333;

        overflow: hidden;
    }

    .rating {
        height: 100%;
        width: calc(var(--rating) * 10%);

        /*
           Green by default for ratings 1-4
        */
        background: #39b54a;

        transition: width 0.2s ease;
    }


    /*
       5-7 = yellow/orange
    */
    .rating.orange {
        background: #f2a900;
    }


    /*
       8-10 = red
    */
    .rating.red {
        background: #e53935;
    }
</style>
</head>

<body>

<div class="canvas">
    <div class="grid">

        <!-- =================================================
             ROW 1
             ================================================= -->

        <div class="item">
            <div class="image-box">
                <img src="images/image1.jpg" alt="">
            </div>
            <div class="rating-container">
                <div class="rating" style="--rating: 1;"></div>
            </div>
        </div>


        <div class="item">
            <div class="image-box">
                <img src="images/image2.jpg" alt="">
            </div>
            <div class="rating-container">
                <div class="rating" style="--rating: 2;"></div>
            </div>
        </div>


        <div class="item">
            <div class="image-box">
                <img src="images/image3.jpg" alt="">
            </div>
            <div class="rating-container">
                <div class="rating" style="--rating: 3;"></div>
            </div>
        </div>


        <div class="item">
            <div class="image-box">
                <img src="images/image4.jpg" alt="">
            </div>
            <div class="rating-container">
                <div class="rating" style="--rating: 4;"></div>
            </div>
        </div>


        <div class="item">
            <div class="image-box">
                <img src="images/image5.jpg" alt="">
            </div>
            <div class="rating-container">
                <div class="rating orange" style="--rating: 5;"></div>
            </div>
        </div>


        <!-- =================================================
             ROW 2
             ================================================= -->

        <div class="item">
            <div class="image-box">
                <img src="images/image6.jpg" alt="">
            </div>
            <div class="rating-container">
                <div class="rating orange" style="--rating: 6;"></div>
            </div>
        </div>


        <div class="item">
            <div class="image-box">
                <img src="images/image7.jpg" alt="">
            </div>
            <div class="rating-container">
                <div class="rating orange" style="--rating: 7;"></div>
            </div>
        </div>


        <div class="item">
            <div class="image-box">
                <img src="images/image8.jpg" alt="">
            </div>
            <div class="rating-container">
                <div class="rating red" style="--rating: 8;"></div>
            </div>
        </div>


        <div class="item">
            <div class="image-box">
                <img src="images/image9.jpg" alt="">
            </div>
            <div class="rating-container">
                <div class="rating red" style="--rating: 9;"></div>
            </div>
        </div>


        <div class="item">
            <div class="image-box">
                <img src="images/image10.jpg" alt="">
            </div>
            <div class="rating-container">
                <div class="rating red" style="--rating: 10;"></div>
            </div>
        </div>

    </div>
</div>


<script>
    /*
       Automatically scale the 1920x1080 canvas to fit
       whatever browser window you're viewing it in.
    */

    function resizeCanvas() {
        const scaleX = window.innerWidth / 1920;
        const scaleY = window.innerHeight / 1080;

        const scale = Math.min(scaleX, scaleY);

        document.documentElement.style.setProperty(
            '--scale',
            scale
        );
    }

    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();
</script>

</body>
</html>
